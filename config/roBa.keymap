#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

&mkp_input_listener { input-processors = <&zip_temp_layer 4 700>; };

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W         &kp E         &kp R                        &kp T                                       &kp Y      &kp U  &kp I      &kp O    &kp P
&kp A      &kp S         &kp D         &kp F                        &kp G        &kp LS(LG(S))      &none       &kp H      &kp J  &kp K      &kp L    &kp MINUS
&kp Z      &kp X         &kp C         &kp V                        &kp B        &kp BACKSPACE      &kp DELETE  &kp N      &kp M  &kp COMMA  &kp DOT  &lt 6 CAPSLOCK
&kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &mt LEFT_SHIFT LS(CAPSLOCK)  &lt 5 SPACE  &lt 3 ENTER        &lt 1 TAB   &lt 2 TAB                             &kp MINUS
            >;

            sensor-bindings = <&encoder_msc_down_up>;
            sensor-bindings = <&encoder_msc_down_up>;
        };

        Symbol {
            bindings = <
&none         &kp APOSTROPHE   &kp LPAR           &kp RPAR  &none                        &kp LPAR          &kp RPAR           &kp SLASH       &kp BACKSLASH      &kp PIPE
&none         &kp DOLLAR       &kp PERCENT        &kp AMPS  &none      &none      &none  &kp LBRC          &kp RBRC           &kp APOSTROPHE  &kp DOUBLE_QUOTES  &none
&kp QUESTION  &kp EXCLAMATION  &kp DOUBLE_QUOTES  &kp HASH  &kp TILDE  &none      &none  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SEMICOLON   &kp COLON          &none
&none         &none            &none              &none     &none      &none      &none  &none                                                                   &none
            >;

            sensor-bindings = <&encoder_msc_down_up>;
            sensor-bindings = <&encoder_msc_down_up>;
        };

        NUM {
            bindings = <
&kp ASTERISK  &kp N7        &kp N8        &kp N9                   &kp PLUS                                 &none       &kp F7  &kp F8  &kp F9  &kp F10
&kp SLASH     &kp NUMBER_4  &kp N5        &kp NUMBER_6             &kp MINUS          &none          &none  &none       &kp F4  &kp F5  &kp F6  &kp F11
&kp PERCENT   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3             &kp PERIOD         &kp EQUAL      &none  &kp ESCAPE  &kp F1  &kp F2  &kp F3  &kp F12
&kp COLON     &kp N0        &kp TILDE     &mt LEFT_SHIFT CAPSLOCK  &kp LC(SEMICOLON)  &none          &none  &none                               &kp F13
            >;

            sensor-bindings = <&encoder_msc_down_up>;
            sensor-bindings = <&encoder_msc_down_up>;
        };

        ARROW {
            bindings = <
&kp ESCAPE          &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &none                      &kp ESCAPE  &kp TAB         &kp UP_ARROW    &kp TAB          &none
&kp HOME            &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &none      &none  &kp HOME    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END
&kp LC(LEFT_SHIFT)  &kp LG(LS(LEFT_ARROW))  &none           &kp LG(LS(RIGHT_ARROW))  &none    &none      &none  &none       &none           &none           &none            &none
&none               &none                   &none           &none                    &none    &none      &none  &none                                                        &none
            >;

            sensor-bindings = <&encoder_msc_down_up>;
            sensor-bindings = <&encoder_msc_down_up>;
        };

        MOUSE {
            bindings = <
&none      &none      &mkp MB4   &mkp MB5   &none                    &kp LC(Y)  &none     &none     &none     &none
&none      &none      &none      &kp LC(F)  &none  &none      &none  &none      &mkp MB1  &mkp MB3  &mkp MB2  &none
&kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &none  &none      &none  &none      &none     &none     &none     &none
&none      &none      &none      &none      &none  &none      &none  &none                                    &none
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&none  &kp N7        &kp N8        &kp N9        &none                          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &none  &none      &none        &none         &none         &none         &none         &none
&none  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &none  &none      &bootloader  &none         &none         &none         &bt BT_CLR    &none
&none  &kp N0        &none         &none         &none  &none      &none        &none                                                   &none
            >;
        };
    };
};
